# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Only needed if the deployed app is served from a different public
# domain than the one issuing requests (rare for this single-server setup).
FRONTEND_URL=

# ── MongoDB ──────────────────────────────────────────────────────
# REQUIRED. Get a free cluster at https://www.mongodb.com/cloud/atlas/register
# (Atlas → Build a Database → Free/M0 → Connect → "Drivers" → copy the string,
# then replace <username>/<password>/<dbname> below). A local mongod URI
# (mongodb://localhost:27017/shah-premium-foods) works too if you have one.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>

# ── JWT ──────────────────────────────────────────────────────────
# REQUIRED. Any long random string works — e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_ACCESS=replace_with_a_long_random_string
JWT_SECRET_REFRESH=replace_with_a_different_long_random_string
# Security audit: access tokens are now genuinely short-lived (paired with
# refresh token rotation — see generateRefreshToken.js / sessionManager.js).
# Leave this at 15m unless you have a specific reason to change it.
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# ── Cloudinary (image uploads — products, avatars, banners) ────
# REQUIRED for image uploads. Free account: https://cloudinary.com/users/register/free
# Dashboard → copy Cloud Name / API Key / API Secret.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET_KEY=your_api_secret

# ── Resend (transactional email — OTPs, password reset) ─────────
# Free account: https://resend.com/signup → API Keys → create one.
# Note: on Resend's free/sandbox tier you can only send TO the email address
# you signed up with until you verify a sending domain — that's expected,
# not a bug. Email delivery failing never blocks registration or login in
# this app; the OTP screen also has a "Resend" button and a "log in now,
# verify later" link for exactly this situation.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Stripe (optional — only needed for online card payments) ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Frontend-exposed config (Next.js) ───────────────────────────
# Left empty = same-origin. Only set this if the API is hosted elsewhere.
NEXT_PUBLIC_API_URL=

# Fix 9: your real deployed domain (no trailing slash), e.g. https://shahpremiumfoods.com
# Used to build absolute URLs in /sitemap.xml — sitemaps require full URLs,
# search engines will reject relative ones. Falls back to a placeholder if unset.
# Security audit: ALSO used by src/lib/security.js to verify the Origin/
# Referer header on every state-changing API request (CSRF protection) —
# set this correctly in production, or that check silently fails open
# (allows the request through rather than blocking it). Section 11 added a
# one-time warning to the security log the first time this happens per
# process (see security.js's own comment), but that's a safety net, not a
# substitute for actually setting this — SameSite=Lax cookies are still the
# primary CSRF defense either way, this header check is one more layer.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CURRENCY_LOCALE=en-BD

# ── Logging (Winston + Morgan) ───────────────────────────────────
# Optional. Only affects self-hosted deployments (see lib/logger.js) —
# on Vercel, logs always go to stdout/stderr (Vercel's own Logs UI/log
# drains), file rotation is skipped automatically regardless of this.
# Defaults to "logs" (relative to wherever the Node process runs) if unset.
LOG_DIR=logs

# ── Admin panel security (Section 13 — optional, all have sane defaults) ──
# Shorter session lifetime specifically for ADMIN/SUPERADMIN accounts —
# see src/server/utils/generateAccessToken.js / generateRefreshToken.js.
ADMIN_ACCESS_TOKEN_EXPIRE=10m
ADMIN_REFRESH_TOKEN_EXPIRE=4h
# Minutes of no mouse/keyboard/scroll activity on /dashboard before an
# automatic logout (a 60s warning shows first) — see
# src/components/IdleLogoutProvider.jsx. NEXT_PUBLIC_ since it's read by
# browser code.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=20

# ── Sentry (error monitoring — optional) ─────────────────────────
# Free account: https://sentry.io/signup/ → create a Next.js project →
# Project Settings → Client Keys (DSN) for the value below.
# Leaving these unset is a safe no-op — Sentry.init() with no DSN does
# nothing; nothing here is required for the app to run normally.
#
# Two separate DSN vars, both the SAME value from your Sentry project:
# NEXT_PUBLIC_SENTRY_DSN is read by browser code (sentry.client.config.js),
# so it needs the NEXT_PUBLIC_ prefix Next.js requires for anything exposed
# client-side; SENTRY_DSN is read by server/edge code
# (sentry.server.config.js / sentry.edge.config.js), which doesn't need
# (and shouldn't have) that prefix. A DSN is meant to be publicly
# embeddable by design (like a Stripe *publishable* key) — this isn't a
# secret-exposure concern, just Next.js env-var mechanics.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for automatic source-map upload at build time (readable
# stack traces in Sentry instead of minified ones) — Sentry project
# Settings → Organization/Project slugs, and Settings → Auth Tokens for a
# token scoped to project:releases. Safe to leave blank; the build still
# works, source maps just won't upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Call Center CRM module (Session 2) ---
# All required for real telephony (click-to-call/WhatsApp and the app's
# own features work fine without any of these). See
# src/modules/callcenter/telephony/README.md for the full setup.
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=callcenter
ASTERISK_ARI_PASSWORD=
ASTERISK_WS_URL=wss://your-domain.com:8089/ws
ASTERISK_SIP_DOMAIN=your-domain.com
ASTERISK_RECORDINGS_DIR=/var/spool/asterisk/monitor
# Optional tuning — sensible defaults apply if left blank. Ring timeout
# and hold music are also live-editable from the Super Admin > Routing &
# Queue Settings page without touching this file.
CALLCENTER_RING_TIMEOUT_MS=20000
PJSIP_AGENTS_CONF_PATH=/etc/asterisk/pjsip_agents.conf
# Only set this if the realtime/telephony layer runs as a SEPARATE
# service from the main app (e.g. storefront stays on Vercel, only
# Socket.IO+ARI run on the VPS) — see the deployment note atop server.js.
# Leave blank for the default (same-origin) setup.
NEXT_PUBLIC_SOCKET_URL=
# Used to normalize locally-formatted phone numbers (e.g. "01712345678")
# into international format for WhatsApp links. Defaults to 880
# (Bangladesh) if left blank.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=880
